# Plantilla de configuración. Copiar a .env y ajustar. NUNCA versionar .env.

# --- Representación -----------------------------------------------------------
# Elegido en ADR-005 tras comparar cuatro configuraciones sobre desarrollo.
# Las sesiones del curso usan e5-small (384 dim); aquí se usa e5-base (768 dim)
# porque es la única configuración densa cuyo MRR supera al baseline léxico.
# La primera ejecución descarga ~1,1 GB.
# Los prefijos query:/passage: son parte del contrato E5 y los aplica el encoder.
AURUM_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Base de datos vectorial --------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aurum-market-catalogo

# Parámetros HNSW. Se declaran aquí para que la ejecución final sea auditable.
# m y ef_construct gobiernan el grafo y exigen reindexar; ef_search se ajusta
# por consulta y es el único que puede barrerse sin reconstruir nada.
AURUM_HNSW_M=24
AURUM_HNSW_EF_CONSTRUCT=120
AURUM_HNSW_EF_SEARCH=128

# Umbrales en KILOBYTES, no en número de vectores. Por debajo de este tamaño
# Qdrant responde por fuerza bruta, así que el índice HNSW no llegaría a
# construirse y la fidelidad ANN sería trivialmente 1,0. Con el valor por
# defecto (20.000 KB) la muestra de 1.500 productos nunca se indexaría.
AURUM_INDEXING_THRESHOLD=1000
AURUM_FULL_SCAN_THRESHOLD=1000

# --- Ingesta ------------------------------------------------------------------
AURUM_BATCH_SIZE=256

# --- Seguridad de las operaciones ---------------------------------------------
# Ninguna operación destructiva se habilita de forma implícita. Para borrar o
# recrear la colección hacen falta las dos variables: el permiso y el nombre
# exacto del recurso escrito a mano.
AURUM_ALLOW_RESET=false
AURUM_CONFIRM_CLEANUP=
