# Plantilla de configuración. Copiar a .env y ajustar. NUNCA versionar .env.

# --- Representación -----------------------------------------------------------
# Modelo heredado de las sesiones 1 y 2. Los prefijos query:/passage: son parte
# del contrato de la familia E5 y los aplica el propio encoder.
AURUM_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Base de datos vectorial --------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aurum-market-catalogo

# Parámetros HNSW. Se declaran aquí para que la ejecución final sea auditable.
AURUM_HNSW_M=24
AURUM_HNSW_EF_CONSTRUCT=120
AURUM_HNSW_EF_SEARCH=128

# --- Ingesta ------------------------------------------------------------------
AURUM_BATCH_SIZE=256

# --- Seguridad de las operaciones ---------------------------------------------
# Ninguna operación destructiva se habilita de forma implícita. Para borrar o
# recrear la colección hacen falta las dos variables: el permiso y el nombre
# exacto del recurso escrito a mano.
AURUM_ALLOW_RESET=false
AURUM_CONFIRM_CLEANUP=
